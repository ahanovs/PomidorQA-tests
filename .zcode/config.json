{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "process",
              "command": "node",
              "args": ["${ZCODE_PROJECT_DIR}/.zcode/hooks/pre-push-check.mjs"],
              "timeoutMs": 600000,
              "statusMessage": "pre-push-check: линт и быстрые тесты перед пушем"
            }
          ]
        }
      ]
    }
  }
}
